PROJECT_NAME="PlaceMentor AI"
API_V1_STR="/api/v1"

# Database Config
# For development, replace with your local PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/placementor_db"

# JWT Config (Generate a strong secret key using openssl rand -hex 32)
SECRET_KEY="replace-this-with-a-very-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis & Celery Config
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Initial Admin User Setup (Optional seeding)
FIRST_SUPERUSER_EMAIL="admin@placementor.ai"
FIRST_SUPERUSER_PASSWORD="SecureAdminPassword123!"
